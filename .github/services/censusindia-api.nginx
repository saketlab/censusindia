location = /api {
    return 301 $scheme://$host/api/;
}

location /api/ {
    # The single R process serves one request at a time.
    limit_req          zone=censusindia_api burst=20 nodelay;
    limit_conn         censusindia_api_conn 4;
    limit_req_status   429;
    limit_conn_status  429;

    proxy_pass         http://127.0.0.1:8895/;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    gzip               on;
    gzip_types         application/json application/geo+json;
}
