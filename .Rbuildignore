^.*\.Rproj$
^\.Rproj\.user$
^data-raw$
^\.claude$
^CLAUDE\.md$
^LICENSE\.md$
^README\.Rmd$
^cran-comments\.md$
^\.github$
^_pkgdown\.yml$
^docs$
# Exclude raw data files (Excel, PDF) from the package
^data/.*\.xlsx$
^data/.*\.pdf$
^data/.*\.zip$
^data/1901-2011$
^data/1961$
^data/1971$
^data/1981$
^data/2026$
^doc$
^Meta$
^vignettes/.*\.csv$
^vignettes/clustering-methodology\.md$
# These analysis articles are built by pkgdown. Building them again as package
# vignettes makes the r-universe source job exceed its time limit.
^vignettes/(district-population|linguistic-diversity|population-dynamics|population-maps|population-projections|primary-census-abstract|sc-st-population|sex-ratio|social-composition|tribal-isolation)\.Rmd$
^parquet$
^geoparquet$
^\.positai$
